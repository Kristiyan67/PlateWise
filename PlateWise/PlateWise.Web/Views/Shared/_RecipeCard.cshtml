@model RecipeCardModel

@{
    var difficultyClass = Model.Difficulty switch
    {
        Difficulty.Easy => "text-bg-success",
        Difficulty.Medium => "text-bg-warning",
        _ => "text-bg-danger"
    };
}

<div class="card h-100 border-0 shadow-sm recipe-card">
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="recipe-card-image card-img-top" alt="@Model.Title"
             loading="lazy" referrerpolicy="no-referrer" />
    }
    else
    {
        <div class="recipe-card-placeholder card-img-top" aria-hidden="true">
            <i class="bi bi-egg-fried"></i>
        </div>
    }

    <div class="card-body d-flex flex-column">
        <div class="mb-2">
            <span class="badge text-bg-light border">@Model.CategoryName</span>
            <span class="badge @difficultyClass">@Model.Difficulty</span>
        </div>

        <h2 class="h5 card-title">
            <a class="stretched-link text-decoration-none text-dark"
               asp-controller="Recipes" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
        </h2>

        <p class="card-text text-muted line-clamp-3">@Model.Description</p>

        <div class="mt-auto d-flex justify-content-between small text-muted">
            <span><i class="bi bi-clock"></i> @Model.TotalTimeMinutes min</span>
            @if (Model.ReviewsCount > 0)
            {
                <span><i class="bi bi-star-fill text-warning"></i> @Model.AverageRating.ToString("0.0") (@Model.ReviewsCount)</span>
            }
            else
            {
                <span>No reviews yet</span>
            }
        </div>
    </div>

    <div class="card-footer bg-white border-0 small text-muted">
        by @Model.AuthorName
    </div>
</div>